# ==============================================================================
# Fixsembly V2 Production Environment Configuration Reference
# ==============================================================================
# Copy this file to '.env' or configure these secrets in your production PaaS
# (e.g., Render, Railway, Vercel, AWS ECS, Fly.io).
# Never commit active secrets or keys to source control.
# ==============================================================================

# ── General Application Settings ──────────────────────────────────────────────
APP_NAME=Fixsembly
ENV=production
APP_VERSION=2.0.0
TAGLINE=Three Agents. One Verified Fix.
PRODUCT_DESCRIPTOR=Self-Healing Multi-Agent Software Engineering System.
FEATURE_MESSAGE=Red to green, automatically.
DEBUG=false
LOG_LEVEL=INFO

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# ── Database ──────────────────────────────────────────────────────────────────
# Production PostgreSQL connection string:
DATABASE_URL=postgresql+psycopg://fixsembly_user:secure_password_here@postgres-host:5432/fixsembly_db

# ── LLM Provider Configuration ────────────────────────────────────────────────
LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=gsk_your_groq_production_api_key_here

# Agent Model Overrides (Optional — defaults to OPENAI_MODEL)
ARCHITECT_MODEL=openai/gpt-oss-120b
CODER_MODEL=openai/gpt-oss-120b
REVIEWER_MODEL=openai/gpt-oss-120b

# Targeted Test Optimization
TARGETED_TESTING_ENABLED=true

# Token & Timeout Bounds
MAX_AGENT_ITERATIONS=5
MAX_LLM_OUTPUT_TOKENS=4096
ARCHITECT_MAX_TOKENS=1600
CODER_MAX_TOKENS=2400
REVIEWER_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=60
LLM_RATE_LIMIT_RETRIES=1
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=30

# ── Code Execution & Sandbox ──────────────────────────────────────────────────
# IMPORTANT: the API blocks EXECUTION_BACKEND=local when ENV=production.
# Point this at a separately isolated sandbox worker before enabling public repairs.
EXECUTION_BACKEND=local
USE_DOCKER_SANDBOX=false
DOCKER_IMAGE=fixsembly-pytest-sandbox:latest
EXECUTION_TIMEOUT_SECONDS=120
PYTEST_TIMEOUT_SECONDS=60

# ── Workspace & File Limits ───────────────────────────────────────────────────
WORKSPACE_BASE_DIR=/app/workspaces
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_SIZE_MB=5
MAX_OUTPUT_SIZE_MB=10
MAX_WORKSPACE_FILES=500

# ── Security & Authentication ─────────────────────────────────────────────────
SECRET_KEY=generate_a_cryptographically_secure_random_64_character_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://fixsembly.com,https://app.fixsembly.com,https://*.vercel.app,http://localhost:5173

# ── Frontend (Vite) Environment Variables ─────────────────────────────────────
# (Consumed during frontend build or set in Vercel project environment)
VITE_API_URL=https://api.fixsembly.com
