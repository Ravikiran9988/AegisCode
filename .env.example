# ==============================================================================
# AegisCode Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development or set these variables in your
# deployment environment (e.g. Render, Railway, Fly.io, AWS).
# ==============================================================================

# ── General Application Settings ──────────────────────────────────────────────
APP_NAME=AegisCode
APP_VERSION=0.1.0
DEBUG=false
ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite — default):
DATABASE_URL=sqlite:///./aegiscode.db
# Production (PostgreSQL via Render — set in Render dashboard, NOT here):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# Note: Render provides 'postgresql://' which is auto-normalised to 'postgresql+psycopg2://'

# ── LLM Provider Configuration ────────────────────────────────────────────────
# Provider selection: 'ollama', 'openai_compatible', or 'mock'
LLM_PROVIDER=mock

# Local Ollama Settings (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Hosted OpenAI-Compatible Settings (when LLM_PROVIDER=openai_compatible)
# For Groq (free tier): set OPENAI_BASE_URL + OPENAI_MODEL as below
# NEVER put a real API key here — set OPENAI_API_KEY in Render dashboard secrets
OPENAI_API_KEY=your_api_key_here_set_via_render_dashboard
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Token & Timeout Bounds
MAX_AGENT_ITERATIONS=5
MAX_LLM_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# ── Code Execution & Sandbox ─────────────────────────────────────────────────
# Backend selection: 'local' (host subprocess) or 'docker' (containerized)
#
# IMPORTANT — Render.com does NOT support Docker-in-Docker (no privileged mode).
# EXECUTION_BACKEND=local is used for the Render demo deployment.
# LocalExecutionBackend runs pytest in workspace-isolated subprocesses:
#   - Each run gets an isolated tmp directory
#   - Path traversal blocked by WorkspaceManager
#   - No shell=True
#   - Timeout enforced (EXECUTION_TIMEOUT_SECONDS)
#   - Output size limited (MAX_OUTPUT_SIZE_MB)
# This is NOT Docker container isolation — documented limitation for capstone demo.
EXECUTION_BACKEND=local
USE_DOCKER_SANDBOX=false
DOCKER_IMAGE=python:3.11-slim
EXECUTION_TIMEOUT_SECONDS=120
PYTEST_TIMEOUT_SECONDS=60

# ── Workspace & File Limits ───────────────────────────────────────────────────
WORKSPACE_BASE_DIR=./workspaces
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_SIZE_MB=5
MAX_OUTPUT_SIZE_MB=10
MAX_WORKSPACE_FILES=500

# ── Security & Network ────────────────────────────────────────────────────────
# Comma-separated list of allowed origin URLs for CORS
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://your-streamlit-app.render.com

# ── Frontend Configuration ────────────────────────────────────────────────────
# URL of the deployed FastAPI backend endpoint accessed by Streamlit
# Local development:
BACKEND_URL=http://localhost:8000
# Production (Render) — set in Render dashboard:
# BACKEND_URL=https://aegiscode-backend.onrender.com
