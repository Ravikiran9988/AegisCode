# ==============================================================================
# AegisCode Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development or set these variables in your
# deployment environment. Never commit real secrets.
# ==============================================================================

# ── General Application Settings ──────────────────────────────────────────────
APP_NAME=AegisCode
APP_VERSION=0.1.0
DEBUG=false
ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite — default):
DATABASE_URL=sqlite:///./aegiscode.db
# Production: set DATABASE_URL in the deployment secret/environment settings.

# ── LLM Provider Configuration ────────────────────────────────────────────────
LLM_PROVIDER=openai_compatible

# Local Ollama Settings (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Hosted OpenAI-Compatible Settings (Groq example)
OPENAI_API_KEY=your_api_key_here_set_in_deployment_secrets
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Strong default model; override per agent below when desired.
OPENAI_MODEL=openai/gpt-oss-120b
# GPT-OSS 20B is faster and supports Groq strict JSON Schema mode.
# Keep the strongest model for coding and use the smaller model for planning/audit.
ARCHITECT_MODEL=openai/gpt-oss-20b
CODER_MODEL=openai/gpt-oss-120b
REVIEWER_MODEL=openai/gpt-oss-20b

# Token & Timeout Bounds
MAX_AGENT_ITERATIONS=5
MAX_LLM_OUTPUT_TOKENS=6144
LLM_TIMEOUT_SECONDS=60

# ── Code Execution & Sandbox ──────────────────────────────────────────────────
EXECUTION_BACKEND=local
USE_DOCKER_SANDBOX=false
DOCKER_IMAGE=python:3.11-slim
EXECUTION_TIMEOUT_SECONDS=120
PYTEST_TIMEOUT_SECONDS=60

# ── Workspace & File Limits ───────────────────────────────────────────────────
WORKSPACE_BASE_DIR=./workspaces
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_SIZE_MB=5
MAX_OUTPUT_SIZE_MB=10
MAX_WORKSPACE_FILES=500

# ── Security & Network ────────────────────────────────────────────────────────
# Add the actual browser/frontend origin(s) used in production.
# Do not hardcode a backend URL here; the frontend reads BACKEND_URL separately.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ── Frontend Configuration ────────────────────────────────────────────────────
# Set this in the frontend deployment environment to the current FastAPI URL.
# Example local value:
# BACKEND_URL=http://localhost:8000
BACKEND_URL=
